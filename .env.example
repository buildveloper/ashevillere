# AshevilleRE Environment Variables
# Copy this to .env.local and fill in your real values

# ─── Required: AI ─────────────────────────────────────────
# Groq AI for chatbot and content generation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Get your API key at https://console.groq.com/keys

# ─── Required: Vercel Blob Storage ─────────────────────────
# For image uploads (listings, blog posts)
# Get these from: vercel.com/dashboard → Storage → Blob → Settings
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here

# ─── Required: Resend Email ─────────────────────────────────
# Transactional email service. Get your API key at https://resend.com/api-keys
# 1. Sign up at resend.com
# 2. Add & verify the `ashevillere.com` domain (DKIM + SPF records)
# 3. Create an API key and paste it below
RESEND_API_KEY=your_resend_api_key_here
# Optional overrides:
#   RESEND_FROM_ADDRESS  = "AshevilleRE <no-reply@ashevillere.com>" (default)
#   OWNER_EMAIL          = "chris@ashevillere.com"   (where buyer inquiries are sent)
#   NEXT_PUBLIC_SITE_URL = "https://ashevillere.com"

# ─── Required: Admin Auth ───────────────────────────────────
# Password for /admin dashboard
ADMIN_PASSWORD=change_this_in_production

# ─── Optional: Upstash Redis ───────────────────────────────
# For server-side rate limiting (fallback: in-memory)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
