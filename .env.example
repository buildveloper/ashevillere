# AshevilleRE Environment Variables
# Copy this to .env.local and fill in your real values

# ─── Required: AI ─────────────────────────────────────────
# Groq AI for chatbot and content generation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Get your API key at https://console.groq.com/keys

# ─── Required: Vercel Blob Storage ─────────────────────────
# For image uploads (listings, blog posts)
# Get these from: vercel.com/dashboard → Storage → Blob → Settings
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here

# ─── Required: Admin Auth ───────────────────────────────────
# Password for /admin dashboard
ADMIN_PASSWORD=change_this_in_production

# ─── Optional: Upstash Redis ───────────────────────────────
# For server-side rate limiting (fallback: in-memory)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
