# AshevilleRE Environment Variables
# Copy this to .env.local and fill in your real values.

# ─── Required: Lead capture (email-only forms) ─────────────
# The inbox that receives "track this address" and contact-form leads.
# Leads POST to /api/lead and are relayed through FormSubmit (free, no API
# key) to this address. The first real submission triggers a one-time
# activation confirmation email from FormSubmit — click it once.
# Leave unset to fail closed: /api/lead returns an honest error instead of
# claiming a lead was captured.
FORMSUBMIT_EMAIL=your@email.com

# ─── Required: Sign-in (magic links) ───────────────────────
# Auth.js secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=generate_a_random_secret
# Resend API key (free tier). Auth.js reads AUTH_RESEND_KEY for the Resend
# magic-link provider. Create at https://resend.com/api-keys, then verify
# your sending domain and update EMAIL_FROM to match it.
AUTH_RESEND_KEY=your_resend_api_key_here
EMAIL_FROM=AshevilleRE <magic@ashevillere.com>
# Trust the Vercel preview host (required off production domains).
AUTH_TRUST_HOST=true

# ─── Required: Turso database (auth + Pro features) ────────
# Create a free database: https://docs.turso.tech/tutorials/create-turso-db
# then copy the URL and token from your Turso dashboard.
# Locally, omit these to use a file database at scripts/db/local.db.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ─── Optional ──────────────────────────────────────────────
# Override the local SQLite file path (default: scripts/db/local.db).
# DATABASE_PATH=./scripts/db/local.db