# AshevilleRE Environment Variables
# Copy this to .env.local and fill in your real values

# Required: Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Get your API key at https://console.groq.com/keys

# Required: Admin password (must be set in production)
ADMIN_PASSWORD=change_this_in_production

# Optional: Upstash Redis for server-side rate limiting
# UPSTASH_REDIS_REST_URL_KV_REST_API_URL=
# UPSTASH_REDIS_REST_URL_KV_REST_API_TOKEN=
